{
  "name": "ai-workspace",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname localhost --port 3000",
    "build": "next build --webpack",
    "release": "npm run build && node scripts/package-release.cjs",
    "start": "next start --hostname localhost",
    "systemd": "node scripts/systemd.cjs",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.3",
    "lucide-react": "^1.40.0",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "shiki": "^4.4.3",
    "typebox": "^1.3.27"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "latest"
  }
